<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily encrypted database backup.

  Deliberately a SEPARATE launchd job from com.analytiq.dailycycle. Backups must
  not depend on the orchestrator working — the whole point is that they keep
  running on the days everything else is broken, and the daily cycle has failed
  on five separate days this month.

  Runs at 12:30, once. It used to also run at 03:00; Adam dropped that trigger on
  2026-08-13, and the reason is worth keeping: this Mac has no host pg_dump, so
  every run shells out to `docker run postgres:17-alpine`. At 03:00 the lid is
  shut and Docker Desktop is down, so that trigger could only ever produce a daily
  error line — noise that teaches you to ignore the log this job writes.

  CAVEAT, same root cause as B1: launchd resolves the Hour below in the timezone
  that was current when this job was bootstrapped, and never re-resolves it. Cross
  five zones and 12:30 becomes 07:30 or 17:30 — and 12:30 was chosen precisely
  because the machine is realistically awake then. After any move, re-bootstrap
  (Uninstall then Install below). If that bites more than once, give this job the
  same treatment as scripts/daily_cycle.sh: an hourly tick plus a slot check the
  script evaluates against local time.

  Install:
    cp deployment/com.analytiq.dbbackup.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.analytiq.dbbackup.plist

  Check:
    launchctl print gui/$UID/com.analytiq.dbbackup | grep -E 'runs|last exit'
    ./scripts/backup_db.sh --list

  Uninstall:
    launchctl bootout gui/$UID/com.analytiq.dbbackup

  NOTE: BACKUP_PASSPHRASE is NOT in this file. It is read from ~/.analytiq_env by
  the script itself, so this plist carries no secret and is safe to commit.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.analytiq.dbbackup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/Documents/GitHub/AnalytIQ/AnalytIQ Repo" &amp;&amp; ./scripts/backup_db.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/analytiq_backup.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/analytiq_backup.err</string>

  <!-- Docker Desktop lives in /usr/local/bin or /opt/homebrew/bin depending on
       install; both are listed so `docker` resolves under launchd's minimal PATH. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
