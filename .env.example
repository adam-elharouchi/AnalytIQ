# AnalytIQ — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# Never commit .env to git.

# ============================================================
# REQUIRED
# ============================================================

# PostgreSQL connection string (from Supabase or your own Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Google Gemini API key (required when FEATURE_AI_EXERCISES=True)
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================
# FLASK
# ============================================================

FLASK_ENV=development        # development | production | testing

# ============================================================
# JWT AUTHENTICATION
# ============================================================

JWT_SECRET_KEY=              # defaults to SECRET_KEY if unset
JWT_EXPIRY_HOURS=168         # legacy (no longer used for access tokens)
JWT_ACCESS_TTL_HOURS=24      # short-lived access token; lower to 1 after verifying
                             # the refresh flow in staging (fully env-tunable)
JWT_REFRESH_TTL_DAYS=30      # refresh token lifetime; exchanged at POST /api/users/refresh

# ============================================================
# DATABASE POOL
# ============================================================

DB_POOL_MIN=2
DB_POOL_MAX=25
DB_CONNECTION_TIMEOUT=10     # seconds
DB_STATEMENT_TIMEOUT=30      # seconds

# ============================================================
# FILE UPLOAD
# ============================================================

MAX_PDF_SIZE_MB=50

# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_DAY=200           # default requests per day
RATE_LIMIT_HOUR=50           # default requests per hour
RATE_LIMIT_SIGNUP=5          # signups per hour per IP
RATE_LIMIT_SIGNIN=10         # sign-ins per minute per IP
RATE_LIMIT_FORGOT_PW=3       # forgot-password requests per hour
RATE_LIMIT_RESET_PW=5        # reset-password requests per hour

# ============================================================
# SECURITY
# ============================================================

BCRYPT_ROUNDS=12
CORS_ORIGINS=*               # comma-separated allowlist; in PRODUCTION set an
                             # explicit list (empty = same-origin only, never "*")
CORS_MAX_AGE=3600
# Shared secret injected by a Cloudflare Transform Rule as the X-Origin-Verify
# header. When set, the app rejects requests that bypass Cloudflare (except
# /api/health), making CF-Connecting-IP trustworthy. Generate: openssl rand -hex 32
ORIGIN_VERIFY_SECRET=
CSRF_TIME_LIMIT=3600         # CSRF token lifetime in seconds

# ============================================================
# AI / GEMINI
# ============================================================

GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60            # seconds

# ============================================================
# EMAIL (required when FEATURE_EMAIL=True)
# ============================================================

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=               # Gmail address
MAIL_PASSWORD=               # Gmail app password (not your account password)
MAIL_DEFAULT_SENDER=noreply@analytiq.com

# ============================================================
# SUPABASE STORAGE
# ============================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=pdfs

# ============================================================
# REDIS / CELERY
# ============================================================

REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300                # cache TTL in seconds (default: 5 min)

# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text              # text | json

# ============================================================
# PAGINATION
# ============================================================

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================================
# PASSWORD RESET
# ============================================================

PW_RESET_EXPIRY_HOURS=24

# ============================================================
# HEALTH CHECK
# ============================================================

HEALTH_CHECK_TIMEOUT=5       # seconds

# ============================================================
# FEATURE FLAGS
# ============================================================

FEATURE_AI_EXERCISES=True
FEATURE_EMAIL=False
FEATURE_ANALYTICS=True
FEATURE_CSRF=False
FEATURE_ASYNC_TASKS=False
FEATURE_CACHING=False

# ============================================================
# LTI 1.3 (LMS Integration)
# ============================================================
# Generate RSA keys with: python3 scripts/generate_lti_keys.py
# Paste each key as a single line with \n replacing newlines.
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=
# Unique identifier for this key (update when rotating keys)
LTI_KEY_ID=analytiq-lti-key-1
# Canonical base URL of your deployment (used in deep linking URLs)
LTI_TOOL_URL=https://myanalytiq.com
# How long (seconds) to keep LTI session records in the DB
LTI_SESSION_TTL=3600

# ============================================================
# SSO (Single Sign-On — requires FEATURE_SSO=True)
# ============================================================

FEATURE_SSO=False
# Dedicated Fernet key for stored SSO client secrets. Falls back to SECRET_KEY
# when unset; set a distinct value so rotating SECRET_KEY/JWT does not invalidate
# stored SSO secrets (changing it requires re-entering provider client secrets).
SSO_ENCRYPTION_KEY=
# Seconds an OAuth2 state token stays valid in Redis
SSO_STATE_TTL=600
# Base URL used to build SSO callback URIs and post-login redirects
FRONTEND_URL=https://myanalytiq.com

# ============================================================
# EMAIL DELIVERY (Resend API — used by async email tasks)
# ============================================================

RESEND_API_KEY=               # Resend API key (https://resend.com)

# ============================================================
# PLATFORM
# ============================================================

# Email of the platform owner (unrestricted superadmin access)
PLATFORM_OWNER_EMAIL=owner@myanalytiq.org
